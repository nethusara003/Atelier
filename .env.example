# --- Supabase (required for live data, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# payhere (default; works for Sri Lankan businesses) or stripe
PAYMENT_PROVIDER=payhere

# --- PayHere (required for checkout when PAYMENT_PROVIDER=payhere) ---
# From your PayHere business account (sandbox.payhere.lk for testing).
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = https://sandbox.payhere.lk, false = https://www.payhere.lk
PAYHERE_SANDBOX=true

# --- Stripe (only needed when PAYMENT_PROVIDER=stripe) ---
# Note: Stripe does not support Sri Lankan businesses receiving payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (optional; falls back to console logging in dev) ---
RESEND_API_KEY=
EMAIL_FROM="Atelier <studio@atelier.example.com>"
ADMIN_EMAIL=studio@atelier.example.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
